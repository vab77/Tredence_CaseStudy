{
  "dataset": "digits",
  "split_seed": 42,
  "train_fraction": 0.7,
  "validation_fraction": 0.15,
  "test_fraction": 0.15,
  "hidden_dims": [
    64,
    32
  ],
  "hidden_activations": [
    "relu",
    "tanh"
  ],
  "input_dim": 64,
  "output_dim": 10,
  "batch_size": 64,
  "epochs": 50,
  "learning_rate": 0.001,
  "adam": {
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-08
  },
  "seeds": [
    0,
    1,
    2
  ],
  "sparsity_targets": [
    0.0,
    0.5,
    0.75,
    0.9,
    0.95
  ],
  "pruning": {
    "scope": "global_weights_only",
    "score_ema_beta": 0.9,
    "warmup_fraction": 0.2,
    "ramp_fraction": 0.6,
    "finetune_fraction": 0.2,
    "interval_epochs": 1,
    "regrowth": false
  },
  "output_dir": "results",
  "method": "magnitude",
  "target_sparsity": 0.95,
  "seed": 0
}
